  "item": [
    {
      "name": "🔐 Auth",
      "description": "Called by `useAuthStore` (client/src/store/useAuthStore.js).\n\n| Store action | HTTP request | On success the client… |\n| --- | --- | --- |\n| `signup` | `POST /auth/signup` | saves token → localStorage, sets `authUser`, connects socket |\n| `login` | `POST /auth/login` | saves token → localStorage, sets `authUser`, connects socket |\n| `checkAuth` | `GET /auth/check` | sets `authUser`, connects socket; on failure clears token |\n| `logout` | `POST /auth/logout` | disconnects socket, clears `authUser` + token |\n| `updateFullName` | `PUT /auth/fullname` | updates `authUser` |\n| `updateProfile` | `PUT /auth/update-profile` | updates `authUser` |",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "",
                  "// Same as client: setAuthToken(res.data.token) + set authUser",
                  "if (res.token) {",
                  "    pm.collectionVariables.set(\"token\", res.token);",
                  "    console.log(\"✅ token saved (client stores it in localStorage.token)\");",
                  "}",
                  "if (res.user && res.user._id) {",
                  "    pm.collectionVariables.set(\"myUserId\", res.user._id);",
                  "    console.log(\"✅ myUserId saved — client would now call connectSocket()\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
